# Strapi Webhook Worker Secrets
# Set these via: wrangler secret put SECRET_NAME

# WEBHOOK_SECRET - Random string to verify Strapi requests
# Generate with: openssl rand -hex 32
# WEBHOOK_SECRET=your-random-secret-here

# CLOUDFLARE_API_TOKEN - Token with Pages edit permission
# Get from: https://dash.cloudflare.com/profile/api-tokens
# CLOUDFLARE_API_TOKEN=your-api-token

# STRAPI_API_URL - Your Strapi instance URL
# STRAPI_API_URL=https://your-strapi-url.com

# STRAPI_TOKEN - Strapi API token with read permissions
# STRAPI_TOKEN=your-strapi-token
