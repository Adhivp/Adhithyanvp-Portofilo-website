# Local development variables (for wrangler dev)
# Set these via wrangler secret put in production

# WORKER_API_KEY=your-strong-random-api-key-here
# Use: wrangler secret put WORKER_API_KEY

# For syncing vectors from Strapi (scripts/sync-from-strapi.js)
STRAPI_API_URL=https://your-strapi-url.com
STRAPI_TOKEN=your-strapi-read-token-here
