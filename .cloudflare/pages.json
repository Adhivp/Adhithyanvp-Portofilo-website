{
  "build": {
    "command": "npm run build",
    "output": "public"
  },
  "routes": [
    {
      "pattern": "/*",
      "cache": {
        "enabled": true,
        "maxAge": 3600
      }
    }
  ],
  "headers": [
    {
      "source": "/**/*.@(jpg|jpeg|gif|png|svg|webp|woff|woff2)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/static/**/*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/page-data/**/*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ]
}
